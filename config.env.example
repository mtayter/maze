# Example config for the maze server. Copy the values install.sh writes here
# into your real config file (default: ~/.config/maze/config.env).
# NEVER put real credentials in this file or commit the real config file.
# The real config file lives OUTSIDE the repo checkout with 0600 permissions.
#
# Format: KEY="value". Values may contain any characters; escape backslash,
# double-quote, dollar and backtick with a backslash inside double quotes.
# Real environment variables take precedence over this file.

# Database the maze API connects to.
MAZE_DB_HOST="localhost"
MAZE_DB_PORT="3306"
MAZE_DB_NAME="maze"
MAZE_DB_USER="maze_app"
MAZE_DB_PASSWORD="<your-db-password>"

# Address the API server listens on. Keep 127.0.0.1 and put it behind a
# reverse proxy (see apache-proxy.conf.example) rather than exposing it.
MAZE_HOST="127.0.0.1"
MAZE_PORT="3000"

# Optional: point the server at a different config file.
# MAZE_CONFIG_FILE="/home/<user>/.config/maze/config.env"
